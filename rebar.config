{project_plugins, [{erlfmt, "~> 1.0"}]}.

{deps, [{cargo, {git, "https://github.com/grisp/erlang-cargo.git",
                      {branch, "cross_build_support_0_1_3"}}}]}.

{eunit_tests, [rebar3_cargo, rebar3_cargo_compile]}.

{ct_opts, [
    {dir, "ct"}
]}.

{dialyzer, [
    {warnings, [unknown]}
]}.

{erlfmt, [
    check,
    verbose,
    {files, ["src/*", "ct/*.erl", "rebar.config"]}
]}.
